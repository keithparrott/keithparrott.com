---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout>
  <p>
    Hi, I'm Keith. This is my personal corner of the internet — mostly
    notes on what I'm reading and building, with the occasional longer
    post when something's worth writing down.
  </p>

  <h2>Latest posts</h2>
  <ul class="post-list">
    {
      latestPosts.map((post) => (
        <li>
          <span class="post-date">
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
          </span>
          <a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
          {post.data.tags.includes('book-review') && <span class="tag">Book review</span>}
        </li>
      ))
    }
  </ul>
  <p><a href="/blog/">All posts &rarr;</a></p>
</BaseLayout>
